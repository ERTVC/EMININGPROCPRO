{
  "entities": {
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Institution branding, store configuration, and authorized member emails for a PROCSTORE workspace.",
      "type": "object",
      "properties": {
        "storeId": {
          "type": "string",
          "description": "Workspace identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the workspace owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "institutionName": {
          "type": "string",
          "description": "Institution display name shown in headers and PDFs.",
          "minLength": 1,
          "maxLength": 120
        },
        "logo": {
          "type": "string",
          "description": "Base64 PNG data URL for the institution logo.",
          "maxLength": 300000
        },
        "memberEmails": {
          "type": "array",
          "description": "Bounded list (max 50) of verified officer emails allowed to access this store."
        },
        "seeded": {
          "type": "boolean",
          "description": "Whether initial sample records have already been initialized."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "storeId",
        "ownerUid",
        "institutionName",
        "logo",
        "memberEmails",
        "seeded",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoreAccess": {
      "title": "StoreAccess",
      "description": "Authorized procurement officer access record managed by the store administrator.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google email address of the authorized officer.",
          "minLength": 3,
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "description": "Assigned store role.",
          "enum": ["admin", "officer", "hod"]
        },
        "department": {
          "type": "string",
          "description": "Assigned department for HOD or Officer accounts, or empty string.",
          "maxLength": 80
        },
        "username": {
          "type": "string",
          "description": "Admin-assigned lowercase login username (e.g. hod, officer, admin).",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9._-]+$"
        },
        "pinSalt": {
          "type": "string",
          "description": "Per-user cryptographic hex salt used for PBKDF2-SHA256 PIN verification.",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-f0-9]+$"
        },
        "pinHash": {
          "type": "string",
          "description": "Salted PBKDF2-SHA256 hex digest of the user login PIN (never plaintext).",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^[a-f0-9]+$"
        },
        "status": {
          "type": "string",
          "description": "Access approval status.",
          "enum": ["active", "revoked"]
        },
        "storeId": {
          "type": "string",
          "description": "Store workspace ID granted by this record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "addedByUid": {
          "type": "string",
          "description": "Admin UID that granted this access.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "email",
        "role",
        "department",
        "username",
        "pinSalt",
        "pinHash",
        "status",
        "storeId",
        "addedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Master inventory item record (either a Consumable with quantity or an Asset template).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storeId": {
          "type": "string",
          "description": "Store workspace ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Creator UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberEmails": {
          "type": "array",
          "description": "Bounded list (max 50) of authorized member emails."
        },
        "name": {
          "type": "string",
          "description": "Item name.",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Item category.",
          "minLength": 1,
          "maxLength": 80
        },
        "department": {
          "type": "string",
          "description": "Assigned department.",
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "description": "Item classification.",
          "enum": ["Asset", "Consumable"]
        },
        "unit": {
          "type": "string",
          "description": "Unit of measure.",
          "minLength": 1,
          "maxLength": 30
        },
        "quantity": {
          "type": "number",
          "description": "Available quantity in base issue units (e.g. Pcs, Meters)."
        },
        "isIGA": {
          "type": "boolean",
          "description": "Whether the item belongs to an Income-Generating Activity."
        },
        "isConsumable": {
          "type": "boolean",
          "description": "True if non-returnable/cut/used up (e.g. cable, paper); false if returnable (e.g. sockets, switches)."
        },
        "purchaseUnit": {
          "type": "string",
          "description": "Optional bulk purchase unit (e.g. Rolls, Boxes).",
          "maxLength": 30
        },
        "unitsPerPurchase": {
          "type": "number",
          "description": "Number of base issue units in one purchase unit (e.g. 90 meters per roll)."
        },
        "location": {
          "type": "string",
          "description": "Optional store shelf, bin, or workshop storage location.",
          "maxLength": 120
        },
        "damagedQty": {
          "type": "number",
          "description": "Cumulative damaged or unusable quantity recorded upon return checks."
        },
        "damagedQuantity": {
          "type": "number",
          "description": "Legacy alias for cumulative damaged or unusable quantity."
        },
        "condition": {
          "type": "string",
          "description": "Condition label for consumables.",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "storeId",
        "ownerUid",
        "memberEmails",
        "name",
        "category",
        "department",
        "type",
        "unit",
        "quantity",
        "isIGA",
        "condition",
        "createdAt",
        "updatedAt"
      ]
    },
